  <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>A Little Surprise For You ✨</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family: Arial, sans-serif;
    min-height:100vh;
    overflow-x:hidden;
    background: linear-gradient(135deg,#ff9a9e,#fad0c4,#fbc2eb,#a6c1ee,#c2ffd8);
    background-size:400% 400%;
    animation:gradient 12s ease infinite;
    color:#fff;
}

@keyframes gradient{
    0%{background-position:0% 50%}
    50%{background-position:100% 50%}
    100%{background-position:0% 50%}
}

.page{
    min-height:100vh;
    display:none;
    justify-content:center;
    align-items:center;
    padding:25px;
    text-align:center;
}

.page.active{
    display:flex;
}

.card{
    width:100%;
    max-width:650px;
    padding:40px 25px;
    border-radius:30px;
    background:rgba(255,255,255,0.18);
    backdrop-filter:blur(15px);
    box-shadow:0 15px 45px rgba(0,0,0,0.2);
    border:2px solid rgba(255,255,255,0.3);
}

h1{
    font-size:2.5rem;
    margin-bottom:20px;
}

p{
    font-size:1.1rem;
    line-height:1.7;
    margin:15px 0;
}

button{
    border:none;
    padding:15px 25px;
    border-radius:50px;
    font-size:16px;
    margin:10px;
    cursor:pointer;
    background:white;
    color:#ff4f81;
    font-weight:bold;
    transition:0.3s;
    box-shadow:0 8px 20px rgba(0,0,0,0.15);
}

button:hover{
    transform:scale(1.1) rotate(-2deg);
}

.big-heart{
    font-size:80px;
    animation:beat 1.2s infinite;
}

@keyframes beat{
    50%{transform:scale(1.2)}
}

.surprise-box{
    font-size:90px;
    cursor:pointer;
    animation:float 2s ease-in-out infinite;
}

@keyframes float{
    50%{
        transform:translateY(-15px) rotate(5deg);
    }
}

.message{
    margin-top:25px;
    font-size:1.3rem;
    min-height:100px;
}

.memory{
    background:rgba(255,255,255,0.25);
    padding:20px;
    margin:15px;
    border-radius:20px;
    cursor:pointer;
    transition:0.3s;
}

.memory:hover{
    transform:scale(1.05);
}

#finalMessage{
    display:none;
    margin-top:25px;
    font-size:1.2rem;
    animation:pop 1s ease;
}

@keyframes pop{
    from{
        transform:scale(0);
        opacity:0;
    }
    to{
        transform:scale(1);
        opacity:1;
    }
}

.floating{
    position:fixed;
    font-size:25px;
    animation:fall linear forwards;
    pointer-events:none;
    z-index:999;
}

@keyframes fall{
    0%{
        transform:translateY(-10vh) rotate(0deg);
        opacity:1;
    }

    100%{
        transform:translateY(110vh) rotate(360deg);
        opacity:0;
    }
}

.answer{
    display:none;
    margin-top:25px;
}

.special{
    font-size:1.5rem;
    font-weight:bold;
}
</style>
</head>

<body>

<!-- PAGE 1 -->

<div class="page active" id="page1">

<div class="card">

<div class="big-heart">💖</div>

<h1>Hey You! ✨</h1>

<p>
I made something small for you...
but warning ⚠️
</p>

<p>
There might be too many surprises,
too many colours,
and maybe one person who misses you a little too much. 🥹
</p>

<button onclick="nextPage(2)">
Open your surprise 🎁
</button>

</div>
</div>


<!-- PAGE 2 -->

<div class="page" id="page2">

<div class="card">

<h1>Surprise #1 🎁</h1>

<div class="surprise-box" onclick="randomMessage()">
🎁
</div>

<p>Tap the gift again and again 👆</p>

<div class="message" id="message">
I have something to tell you... 👀
</div>

<button onclick="nextPage(3)">
Next surprise ➜
</button>

</div>
</div>


<!-- PAGE 3 -->

<div class="page" id="page3">

<div class="card">

<h1>A few things... 🌈</h1>

<p>Tap each one 👇</p>

<div class="memory" onclick="reveal(this, 'Some people enter your life and somehow make ordinary days feel less ordinary. ✨')">
✨ Something I realised
</div>

<div class="memory" onclick="reveal(this, 'I still randomly remember conversations with you and smile like an idiot. 😭')">
😂 Something embarrassing
</div>

<div class="memory" onclick="reveal(this, 'You have no idea how often something happens and my first thought is: I wish I could tell her this. 💌')">
💭 Something true
</div>

<button onclick="nextPage(4)">
One last surprise 💖
</button>

</div>
</div>


<!-- PAGE 4 -->

<div class="page" id="page4">

<div class="card">

<div class="big-heart">🥹💗</div>

<h1>Okay... honestly?</h1>

<p>
I made all of this because sometimes
"I miss you" feels way too small.
</p>

<p>
Because missing someone isn't always about wanting
a huge conversation.
</p>

<p>
Sometimes you just miss their presence.
Their random messages.
Their voice.
Their existence somewhere in your day.
</p>

<p class="special">
And yes... lately, I've been missing you a lot. 💗
</p>

<button onclick="showFinal()">
There's one more thing...
</button>

<div id="finalMessage">

<p>
If you were here right now,
I think I would probably annoy you,
make you laugh,
and then pretend I didn't miss you that much. 😭❤️
</p>

<h2>So... can I see you soon? 🥹</h2>

<button onclick="yesAnswer()">
YES 🥹💖
</button>

<button onclick="noAnswer()">
Maybe 😏
</button>

<div class="answer" id="answer"></div>

</div>

</div>
</div>


<script>

const messages = [

"I miss talking to you. 🥹",

"Some songs still make me think of you. 🎶",

"I wonder if you miss me sometimes too. 👀",

"Okay fine... I miss you A LOT. 😭💗",

"You're probably smiling right now. Don't lie. 😏",

"If you are reading this... send me a message maybe? 👀💌",

"You have occupied way too much space in my head. Rent bhi nahi deti. 😭😂",

"Surprise! This entire website was basically an excuse to say I miss you. 🥹❤️"

];

function randomMessage(){

const random =
messages[Math.floor(Math.random()*messages.length)];

document.getElementById("message").innerHTML=random;

}

function nextPage(number){

document.querySelectorAll(".page").forEach(page=>{
page.classList.remove("active");
});

document.getElementById("page"+number).classList.add("active");

createConfetti();

}

function reveal(element,text){

element.innerHTML=text;
element.style.background="rgba(255,255,255,0.45)";

}

function showFinal(){

document.getElementById("finalMessage").style.display="block";

createConfetti();

}

function yesAnswer(){

document.getElementById("answer").style.display="block";

document.getElementById("answer").innerHTML=
"YAYYYYY 😭💖 Okay then, it's a date. You just made someone's day 100 times better. 🥹✨";

createConfetti();

}

function noAnswer(){

document.getElementById("answer").style.display="block";

document.getElementById("answer").innerHTML=
"Maybe is basically a future YES. I accept. 😌😂💗";

}

function createConfetti(){

const emojis=["💖","✨","🌸","🎀","💌","🦋","🌈"];

for(let i=0;i<25;i++){

const item=document.createElement("div");

item.className="floating";

item.innerHTML=
emojis[Math.floor(Math.random()*emojis.length)];

item.style.left=Math.random()*100+"vw";

item.style.animationDuration=
(3+Math.random()*3)+"s";

document.body.appendChild(item);

setTimeout(()=>{
item.remove();
},6000);

}

}

</script>

</body>
</html>